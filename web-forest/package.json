{
  "name": "web-forest",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.worker.json && tsc --noEmit -p tsconfig.test.json",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "node --test --experimental-strip-types test/*.test.ts",
    "smoke:detect": "node script/smoke-detect.mjs",
    "bench:hall": "node script/bench-hall.mjs",
    "handset": "npm run build && node script/serve-https.mjs",
    "sync": "node --experimental-strip-types server/sync-server.mjs --port 8788",
    "deploy": "npm run build && wrangler deploy",
    "audit:model": "node script/audit-model.mjs",
    "audit:location": "node --experimental-strip-types script/audit-location.ts",
    "bench:frame": "node script/bench-frame.mjs"
  },
  "dependencies": {
    "@google/model-viewer": "^4.3.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260930.2",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^24.19.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "opentype.js": "^1.3.4",
    "oxlint": "^1.75.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^8.2.0",
    "wrangler": "^4.131.1"
  }
}
