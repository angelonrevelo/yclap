{
  // Magisphere PWA + same-origin campus world.
  "name": "yclap-field-guide",
  "compatibility_date": "2026-09-02",
  "main": "./worker/sync.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/world", "/sync", "/live", "/health", "/join", "/mine", "/inat/identify"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "CAMPUS", "class_name": "CampusWorld" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["CampusWorld"] }
  ]
}
